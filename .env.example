# Copy to .env for local development. Existing process variables take precedence.
# Data directory (relative to the working directory unless an absolute path is used).
ASSISTANT_DATA_DIR=data
# The offline stub needs no API key. Other providers require LLM_API_KEY.
LLM_PROVIDER=stub
# Keep this blank in Git. Put a real key only in your ignored .env or process env.
LLM_API_KEY=
# Positive fee per credit in VND.
CREDIT_RATE_VND=450000
# Finite, positive multiplier for retaken credits.
RETAKE_MULTIPLIER=1.5
# Maximum regular credits allowed per request (positive integer).
MAX_CREDITS=30
# Standard Python logging level; logs are JSON on stderr.
LOG_LEVEL=INFO
