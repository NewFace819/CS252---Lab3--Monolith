{
  "info": {
    "name": "Study Assistant API v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "admin_key",
      "value": "change-me"
    },
    {
      "key": "request_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "health",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"health: status is 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base}}/health",
          "host": [
            "{{base}}"
          ],
          "path": [
            "health"
          ]
        }
      }
    },
    {
      "name": "chat - fee (saves request_id)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"chat - fee (saves request_id): status is 200\", function () { pm.response.to.have.status(200); });",
              "var data = pm.response.json();",
              "pm.test(\"response has request_id\", function () { pm.expect(data.request_id).to.be.a(\"string\").and.not.empty; });",
              "pm.collectionVariables.set(\"request_id\", data.request_id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base}}/v1/chat",
          "host": [
            "{{base}}"
          ],
          "path": [
            "v1",
            "chat"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"message\": \"tuition for 18 credits and 2 retake\", \"session_id\": \"demo\"}"
        }
      }
    },
    {
      "name": "chat - rule",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"chat - rule: status is 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base}}/v1/chat",
          "host": [
            "{{base}}"
          ],
          "path": [
            "v1",
            "chat"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"message\": \"can I register my thesis with 118 credits\"}"
        }
      }
    },
    {
