    {
      "name": "weather (200, or 503 if upstream down)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"weather (200, or 503 if upstream down): status is 200 or 503\", function () { pm.expect(pm.response.code).to.be.oneOf([200, 503]); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
